{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ---------------------------------------------------------------------
  // INSTALACION LOCAL
  //
  // Esta cadena apunta a SQL Server local con autenticacion integrada de
  // Windows: NO contiene usuario ni contrasena, por eso puede vivir aqui
  // sin riesgo. Cambia el "Data Source" si tu instancia se llama distinto
  // (por ejemplo ".\\SQLEXPRESS" o "localhost").
  //
  // Si algun dia se despliega en un servidor, la cadena de ese entorno se
  // pone en una variable de entorno ConnectionStrings__CadenaSQL y esta
  // queda ignorada.
  // ---------------------------------------------------------------------
  "ConnectionStrings": {
    "CadenaSQL": "Data Source=DESKTOP-S4PP812;Initial Catalog=Nicatek;Integrated Security=True;Encrypt=False;TrustServerCertificate=True"
  },

  // ---------------------------------------------------------------------
  // La clave de firma del JWT NO va en este archivo (se versiona en git).
  // En local, si no hay ninguna configurada, la API genera una y la guarda
  // en el archivo .jwt-dev-key junto al proyecto, que esta en .gitignore.
  // No hay que hacer nada manualmente.
  // ---------------------------------------------------------------------
  "Jwt": {
    "Issuer": "NicaTekAPI",
    "Audience": "NicaTekClients",
    "ExpiracionMinutos": 480
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },

  // ---------------------------------------------------------------------
  // Ajustes pensados para esta instalacion LOCAL.
  // Si algun dia se publica en un servidor accesible desde internet:
  //   ForzarHttps      -> true
  //   PublicarSwagger  -> false
  // ---------------------------------------------------------------------
  "Seguridad": {
    "ForzarHttps": false,
    "PublicarSwagger": true
  }
}
