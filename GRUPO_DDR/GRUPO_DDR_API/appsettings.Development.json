{
  // La cadena de conexion y el resto de la configuracion viven en
  // appsettings.json, que ya apunta a la base local. Este archivo solo
  // sube el detalle de los logs mientras se desarrolla.
  //
  // Si necesitas apuntar a OTRA base solo en desarrollo, descomenta el
  // bloque ConnectionStrings de abajo: sobrescribe al de appsettings.json.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }

  //,"ConnectionStrings": {
